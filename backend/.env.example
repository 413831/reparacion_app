# ==============================================================================
# REPARATUTTI BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development. NEVER COMMIT REAL CREDENTIALS.
# ==============================================================================

# Server Runtime
PORT=8080
APP_ENV=development

# JWT Authentication (Use 64+ char high-entropy secret in production)
JWT_SECRET=change-this-to-a-secure-random-secret-key-at-least-32-bytes

# Rate Limiter Settings
RATE_LIMIT_RPM=80
RATE_LIMIT_BURST=20

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=reparatutti_app
DB_PASSWORD=your_secure_db_password_here
DB_NAME=reparatutti_db
DB_SSLMODE=disable
# Or complete connection string:
# DATABASE_URL=postgres://user:password@localhost:5432/reparatutti_db?sslmode=disable

# Payment Gateway (MercadoPago)
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADOPAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000

# Mobile Store Release & Version Management (Remote Config)
MIN_IOS_BUILD=1
MIN_IOS_VERSION=1.0.0
MIN_ANDROID_BUILD=1
MIN_ANDROID_VERSION=1.0.0
IOS_STORE_URL=https://apps.apple.com/app/reparatutti/id1234567890
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.reparatutti.app
